#!/usr/bin/env bash

set -euo pipefail

readonly script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly source_dir="${HOME}/laksa_ws/src/frontier_exploration_ros2"
readonly upstream_url="https://github.com/mertgulerx/frontier_exploration_ros2.git"
readonly upstream_commit="ec530d2a813739cd25dd0c438d2365c510b9fad8"
readonly patch_file="${script_dir}/../patches/frontier-exploration-completion-stability.patch"

if [[ ! -f "${patch_file}" ]]; then
    echo "Frontier explorer completion patch not found: ${patch_file}" >&2
    exit 1
fi

mkdir -p "$(dirname -- "${source_dir}")"
if [[ ! -e "${source_dir}" ]]; then
    git clone "${upstream_url}" "${source_dir}"
elif [[ ! -d "${source_dir}/.git" ]]; then
    echo "Refusing to replace non-git path: ${source_dir}" >&2
    exit 1
fi

git -C "${source_dir}" fetch --depth 1 origin "${upstream_commit}"
if [[ "$(git -C "${source_dir}" rev-parse HEAD)" != "${upstream_commit}" ]]; then
    if ! git -C "${source_dir}" diff --quiet || \
       ! git -C "${source_dir}" diff --cached --quiet; then
        echo "Refusing to switch commits with local frontier explorer changes" >&2
        exit 1
    fi
    git -C "${source_dir}" checkout --detach "${upstream_commit}"
fi

# A successful reverse check means this exact patch is already installed.
# Otherwise only apply it to the pristine pinned revision; this makes reruns
# idempotent without hiding unrelated or partially applied source changes.
if ! git -C "${source_dir}" apply --reverse --check "${patch_file}" 2>/dev/null; then
    if ! git -C "${source_dir}" diff --quiet || \
       ! git -C "${source_dir}" diff --cached --quiet; then
        echo "Refusing to mix the LAKSA frontier explorer patch with unrelated changes" >&2
        exit 1
    fi
    git -C "${source_dir}" apply --check "${patch_file}"
    git -C "${source_dir}" apply "${patch_file}"
fi

set +u
source /opt/ros/humble/setup.bash
set -u
cd "${HOME}/laksa_ws"
colcon build --symlink-install --packages-select frontier_exploration_ros2
