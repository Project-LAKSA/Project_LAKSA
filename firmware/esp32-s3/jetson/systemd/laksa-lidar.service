[Unit]
Description=LAKSA RPLIDAR A2M12 sensor stream
After=systemd-udev-settle.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=dialout
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=1
EnvironmentFile=/etc/laksa/ros-runtime.env
Environment=LAKSA_LIDAR_DEVICE=/dev/laksa_lidar
Environment=LAKSA_MAPPING_MODE=sensor
ExecStart=/usr/local/lib/laksa/laksa-lidar-mapping
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
