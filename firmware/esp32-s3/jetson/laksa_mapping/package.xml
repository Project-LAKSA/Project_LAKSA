<?xml version="1.0"?>
<package format="3">
  <name>laksa_mapping</name>
  <version>0.1.0</version>
  <description>Deterministic manual mapping lifecycle and profiles for LAKSA.</description>
  <maintainer email="project-laksa@invalid.local">Project LAKSA</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rtabmap_msgs</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>laksa_description</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
