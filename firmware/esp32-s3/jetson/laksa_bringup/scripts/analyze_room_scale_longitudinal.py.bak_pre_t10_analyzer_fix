#!/usr/bin/env python3

"""Offline analysis for ROOM_SCALE_LONGITUDINAL_V1 JSONL trial recordings."""

from __future__ import annotations

import argparse
import json
import math
from pathlib import Path
from typing import Any, Dict, List, Optional



def read_records(trial_dir: Path) -> List[Dict[str, Any]]:
    records = []
    for path in sorted((trial_dir / "raw_bag").glob("*.jsonl")):
        for line in path.read_text(encoding="utf-8").splitlines():
            if line.strip():
                records.append(json.loads(line))
    return sorted(records, key=lambda item: item["received_monotonic"])


def values(records: List[Dict[str, Any]], topic: str, field: str) -> List[tuple[float, float]]:
    result = []
    for record in records:
        if record["topic"] != topic:
            continue
        value = record["data"].get(field)
        if isinstance(value, (int, float)) and math.isfinite(float(value)):
            result.append((float(record["received_monotonic"]), float(value)))
    return result


def peak(items: List[tuple[float, float]]) -> Optional[float]:
    return max((value for _, value in items), default=None)


def minimum(items: List[tuple[float, float]]) -> Optional[float]:
    return min((value for _, value in items), default=None)


def response_latency(
    requested: List[tuple[float, float]],
    measured: List[tuple[float, float]],
    target: float,
) -> Optional[float]:
    if not requested or not measured:
        return None
    start = requested[0][0]
    threshold = abs(target) * 0.10
    for stamp, value in measured:
        if stamp >= start and abs(value) >= threshold:
            return stamp - start
    return None


def trial_report(trial_dir: Path) -> Dict[str, Any]:
    records = read_records(trial_dir)
    metadata = {}
    metadata_path = trial_dir / "metadata.yaml"
    if metadata_path.exists():
        metadata = {"metadata_path": str(metadata_path)}
    target = 0.0
    direction = trial_dir.name
    for record in records:
        if record["topic"] == "/laksa/state":
            target = float(record["data"].get("requested_erpm", target))
            break
    measured = values(records, "/laksa/vesc/state", "measured_erpm")
    requested = values(records, "/laksa/vesc/state", "requested_erpm")
    motor_current = values(records, "/laksa/vesc/state", "motor_current_a")
    input_current = values(records, "/laksa/vesc/state", "input_current_a")
    voltage = values(records, "/laksa/vesc/state", "input_voltage_v")
    duty = values(records, "/laksa/vesc/state", "duty_cycle")
    accel = values(records, "/laksa/imu/data", "linear_acceleration_m_s2")
    accel_x = []
    for record in records:
        if record["topic"] == "/laksa/imu/data":
            vector = record["data"].get("linear_acceleration_m_s2", {})
            value = vector.get("x")
            if isinstance(value, (int, float)) and math.isfinite(float(value)):
                accel_x.append((float(record["received_monotonic"]), float(value)))
    return {
        "trial": direction,
        "record_count": len(records),
        "requested_erpm_observed_peak": peak(requested),
        "measured_erpm_peak_abs": max((abs(value) for _, value in measured), default=None),
        "measured_erpm_overshoot_abs": (
            max((abs(value) for _, value in measured), default=0.0) - abs(target)
            if measured
            else None
        ),
        "response_latency_sec_to_10_percent": response_latency(requested, measured, target),
        "peak_motor_current_a": peak(motor_current),
        "peak_input_current_a": peak(input_current),
        "minimum_input_voltage_v": minimum(voltage),
        "voltage_sag_v": (
            max(voltage, key=lambda item: item[1])[1] - min(voltage, key=lambda item: item[1])[1]
            if voltage
            else None
        ),
        "peak_duty_cycle": peak(duty),
        "peak_imu_longitudinal_acceleration_m_s2": peak(accel_x),
        "mean_imu_longitudinal_acceleration_m_s2_initial": (
            sum(value for _, value in accel_x) / len(accel_x) if accel_x else None
        ),
        "erpm_decay_after_neutral_observable": bool(measured),
        "imu_deceleration_after_neutral_observable": bool(accel_x),
        "distance_claim": "UNAVAILABLE: fused odometry was not required or recorded",
        **metadata,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Analyze room-scale longitudinal JSONL trials.")
    parser.add_argument("session_dir", type=Path)
    args = parser.parse_args()
    trials = sorted((args.session_dir / "trials").glob("trial_*"))
    report = {"test_label": "ROOM_SCALE_LONGITUDINAL_V1", "trials": [trial_report(path) for path in trials]}
    if len(report["trials"]) >= 2:
        report["forward_vs_reverse"] = "Compare signed measured eRPM, currents, voltage, duty, and IMU acceleration; no distance claim is made."
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
