SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="619c672b30b581469256951e7727b7d4", SYMLINK+="laksa_lidar", SYMLINK+="lidar", GROUP="dialout", MODE="0660"

