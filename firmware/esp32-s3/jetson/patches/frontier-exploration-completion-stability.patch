 namespace frontier_exploration_ros2
 {
 
+void FrontierExplorerCore::reset_completion_verification()
+{
+  no_frontier_since_ns.reset();
+  last_empty_map_generation.reset();
+  consecutive_empty_map_generations = 0;
+  completion_known_cells_baseline = 0U;
+  no_frontiers_reported = false;
+}
+
+std::size_t FrontierExplorerCore::known_map_cell_count() const
+{
+  if (!map.has_value()) {
+    return 0U;
+  }
+
+  const auto & cells = map->map().data;
+  return static_cast<std::size_t>(std::count_if(
+      cells.begin(),
+      cells.end(),
+      [](int8_t value) {
+        return value != static_cast<int8_t>(OccupancyGrid2d::CostValues::NoInformation);
+      }));
+}
+
+bool FrontierExplorerCore::completion_verification_ready()
+{
+  const int64_t now_ns = callbacks.now_ns();
+  const std::size_t known_cells = known_map_cell_count();
+
+  if (!no_frontier_since_ns.has_value()) {
+    no_frontier_since_ns = now_ns;
+    last_empty_map_generation = map_generation;
+    consecutive_empty_map_generations = 1;
+    completion_known_cells_baseline = known_cells;
+    // A zero-duration, single-generation policy explicitly disables the
+    // debounce and preserves the package's historical immediate completion.
+    return params.completion_stability_sec <= 0.0 &&
+           params.completion_min_empty_map_generations <= 1;
+  }
+
+  if (!last_empty_map_generation.has_value() ||
+    *last_empty_map_generation != map_generation)
+  {
+    const std::size_t growth_cells = known_cells > completion_known_cells_baseline ?
+      known_cells - completion_known_cells_baseline : 0U;
+    const double growth_ratio = completion_known_cells_baseline == 0U ?
+      (growth_cells > 0U ? 1.0 : 0.0) :
+      static_cast<double>(growth_cells) /
+      static_cast<double>(completion_known_cells_baseline);
+
+    if (
+      growth_cells > 0U &&
+      growth_ratio >= params.completion_known_area_growth_ratio)
+    {
+      // A growing known region means SLAM is still revealing the environment.
+      // Start a new completion evidence window from this map generation.
+      no_frontier_since_ns = now_ns;
+      last_empty_map_generation = map_generation;
+      consecutive_empty_map_generations = 1;
+      completion_known_cells_baseline = known_cells;
+      callbacks.log_info(
+        "Known map area grew during completion verification; restarting the stability window");
+      return false;
+    }
+
+    last_empty_map_generation = map_generation;
+    consecutive_empty_map_generations += 1;
+  }
+
+  const double stable_seconds = std::max(
+    0.0,
+    static_cast<double>(now_ns - *no_frontier_since_ns) / 1e9);
+  return stable_seconds >= params.completion_stability_sec &&
+         consecutive_empty_map_generations >= params.completion_min_empty_map_generations;
+}
