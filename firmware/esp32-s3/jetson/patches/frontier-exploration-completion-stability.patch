+nav_msgs::msg::OccupancyGrid build_grid(int known_cells)
+{
+  nav_msgs::msg::OccupancyGrid msg;
+  msg.info.width = 20U;
+  msg.info.height = 10U;
+  msg.info.resolution = 1.0;
+  msg.info.origin.orientation.w = 1.0;
+  msg.data.assign(200U, static_cast<int8_t>(-1));
+  for (int index = 0; index < known_cells; ++index) {
+    msg.data[static_cast<std::size_t>(index)] = 0;
+  }
+  return msg;
+}
+
+struct CompletionHarness
+{
+  std::shared_ptr<int64_t> now_ns;
+  std::shared_ptr<int> completion_calls;
+  std::shared_ptr<bool> report_frontier;
+  std::unique_ptr<FrontierExplorerCore> core;
+};
+
+CompletionHarness make_completion_harness(int known_cells = 100)
+{
+  CompletionHarness harness;
+  harness.now_ns = std::make_shared<int64_t>(0);
+  harness.completion_calls = std::make_shared<int>(0);
+  harness.report_frontier = std::make_shared<bool>(false);
+
+  FrontierExplorerCoreParams params;
+  params.frontier_map_optimization_enabled = false;
+  params.return_to_start_on_complete = false;
+  params.escape_enabled = false;
+  params.completion_stability_sec = 20.0;
+  params.completion_min_empty_map_generations = 10;
+  params.completion_known_area_growth_ratio = 0.01;
+
+  FrontierExplorerCoreCallbacks callbacks;
+  callbacks.now_ns = [now_ns = harness.now_ns]() {return *now_ns;};
+  callbacks.get_current_pose = []() {
+      geometry_msgs::msg::Pose pose;
+      pose.position.x = 2.0;
+      pose.position.y = 2.0;
+      pose.orientation.w = 1.0;
+      return std::optional<geometry_msgs::msg::Pose>(pose);
+    };
+  callbacks.wait_for_action_server = [](double) {return false;};
+  callbacks.on_exploration_complete = [calls = harness.completion_calls]() {
+      *calls += 1;
+    };
+  callbacks.log_debug = [](const std::string &) {};
+  callbacks.log_info = [](const std::string &) {};
+  callbacks.log_warn = [](const std::string &) {};
+  callbacks.log_error = [](const std::string &) {};
+  callbacks.frontier_search = [report_frontier = harness.report_frontier](
+    const geometry_msgs::msg::Pose &,
+    const OccupancyGrid2d &,
+    const OccupancyGrid2d &,
+    const std::optional<OccupancyGrid2d> &,
+    double,
+    bool)
+    {
+      FrontierSearchResult result;
+      result.robot_map_cell = {2, 2};
+      if (*report_frontier) {
+        result.frontiers = {FrontierCandidate{{4.0, 4.0}, {4.0, 4.0}, 8}};
+      }
+      return result;
+    };
+
+  harness.core = std::make_unique<FrontierExplorerCore>(params, callbacks);
+  harness.core->map = OccupancyGrid2d(build_grid(known_cells));
+  harness.core->costmap = OccupancyGrid2d(build_grid(200));
+  harness.core->map_generation = 1;
+  harness.core->costmap_generation = 1;
+  return harness;
+}
+
+void observe_generation(CompletionHarness & harness, int generation, int64_t now_ns)
+{
+  harness.core->map_generation = generation;
+  *harness.now_ns = now_ns;
+  harness.core->try_send_next_goal();
+}
+
+TEST(CompletionStabilityTests, RepeatedSchedulerCallsForOneMapCountOnce)
+{
+  auto harness = make_completion_harness();
+
+  observe_generation(harness, 1, 0);
+  observe_generation(harness, 1, 25'000'000'000);
+  observe_generation(harness, 1, 60'000'000'000);
+
+  EXPECT_EQ(*harness.completion_calls, 0);
+  EXPECT_EQ(harness.core->consecutive_empty_map_generations, 1);
+  EXPECT_FALSE(harness.core->return_to_start_completed);
+}
+
+TEST(CompletionStabilityTests, RequiresTenDistinctMapsAndTwentySeconds)
+{
+  auto harness = make_completion_harness();
+
+  for (int generation = 1; generation <= 9; ++generation) {
+    observe_generation(
+      harness,
+      generation,
+      static_cast<int64_t>(generation - 1) * 2'000'000'000);
+  }
+  EXPECT_EQ(*harness.completion_calls, 0);
+
+  observe_generation(harness, 10, 19'000'000'000);
+  EXPECT_EQ(harness.core->consecutive_empty_map_generations, 10);
+  EXPECT_EQ(*harness.completion_calls, 0);
+
+  // The same generation may satisfy the time half of the conjunction, but it
+  // does not add another map sample.
+  observe_generation(harness, 10, 20'000'000'000);
+  EXPECT_EQ(*harness.completion_calls, 1);
+  EXPECT_TRUE(harness.core->return_to_start_completed);
+}
+
+TEST(CompletionStabilityTests, AFrontierResetsTransientEmptyEvidence)
+{
+  auto harness = make_completion_harness();
+
+  observe_generation(harness, 1, 0);
+  *harness.report_frontier = true;
+  harness.core->frontier_snapshot.reset();
+  observe_generation(harness, 2, 5'000'000'000);
+
+  *harness.report_frontier = false;
+  harness.core->frontier_snapshot.reset();
+  observe_generation(harness, 3, 30'000'000'000);
+  observe_generation(harness, 3, 60'000'000'000);
+
+  EXPECT_EQ(*harness.completion_calls, 0);
+  EXPECT_EQ(harness.core->consecutive_empty_map_generations, 1);
+}
+
+TEST(CompletionStabilityTests, KnownAreaGrowthRestartsEvidenceWindow)
+{
+  auto harness = make_completion_harness(100);
+
+  observe_generation(harness, 1, 0);
+  // Exactly one percent growth meets the configured reset threshold.
+  harness.core->map = OccupancyGrid2d(build_grid(101));
+  harness.core->decision_map_dirty = true;
+  observe_generation(harness, 2, 21'000'000'000);
+
+  EXPECT_EQ(*harness.completion_calls, 0);
+  EXPECT_EQ(harness.core->consecutive_empty_map_generations, 1);
+  EXPECT_EQ(harness.core->completion_known_cells_baseline, 101U);
+
+  for (int generation = 3; generation <= 11; ++generation) {
+    observe_generation(
+      harness,
+      generation,
+      21'000'000'000 + static_cast<int64_t>(generation - 2) * 2'000'000'000);
+  }
+  EXPECT_EQ(*harness.completion_calls, 0);
+
+  observe_generation(harness, 12, 41'000'000'000);
+  EXPECT_EQ(*harness.completion_calls, 1);
+}
+
+TEST(CompletionStabilityTests, RestartClearsPriorEvidence)
+{
+  auto harness = make_completion_harness();
+  for (int generation = 1; generation <= 9; ++generation) {
+    observe_generation(
+      harness,
+      generation,
+      static_cast<int64_t>(generation - 1) * 2'000'000'000);
+  }
+
+  harness.core->start_exploration_session();
+  harness.core->map = OccupancyGrid2d(build_grid(100));
+  harness.core->costmap = OccupancyGrid2d(build_grid(200));
+  harness.core->map_generation = 1;
+  harness.core->costmap_generation = 1;
+  observe_generation(harness, 1, 40'000'000'000);
+  observe_generation(harness, 1, 70'000'000'000);
+
+  EXPECT_EQ(*harness.completion_calls, 0);
+  EXPECT_EQ(harness.core->consecutive_empty_map_generations, 1);
+}
+
+}  // namespace
+}  // namespace frontier_exploration_ros2
