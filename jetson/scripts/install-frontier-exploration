#!/usr/bin/env bash

set -euo pipefail

readonly source_dir="${HOME}/laksa_ws/src/frontier_exploration_ros2"
readonly upstream_url="https://github.com/mertgulerx/frontier_exploration_ros2.git"
readonly upstream_commit="ec530d2a813739cd25dd0c438d2365c510b9fad8"

if [[ ! -d "${source_dir}/.git" ]]; then
    git clone "${upstream_url}" "${source_dir}"
fi

git -C "${source_dir}" fetch --depth 1 origin "${upstream_commit}"
if [[ "$(git -C "${source_dir}" rev-parse HEAD)" != "${upstream_commit}" ]]; then
    if ! git -C "${source_dir}" diff --quiet || \
       ! git -C "${source_dir}" diff --cached --quiet; then
        echo "Refusing to switch commits with local frontier explorer changes" >&2
        exit 1
    fi
    git -C "${source_dir}" checkout --detach "${upstream_commit}"
fi

set +u
source /opt/ros/humble/setup.bash
set -u
cd "${HOME}/laksa_ws"
colcon build --symlink-install --packages-select frontier_exploration_ros2
